    {
      "parameters": {
        "jsCode": "return [\n{\njson: {\norderId: \"ORD-7001\",\ncustomerEmail: \"david@enterprise.com\",\nsku: \"SKU-KB-01\",\nquantity: 2,\nnotes: \"Standard order - ample stock available\"\n}\n},\n{\njson: {\norderId: \"ORD-7002\",\ncustomerEmail: \"elena@startup.io\",\nsku: \"SKU-MO-02\",\nquantity: 2,\nnotes: \"Will breach reorder point (6 - 2 = 4 <= 5)\"\n}\n},\n{\n  json: {\norderId: \"ORD-7003\",\ncustomerEmail: \"frank@consulting.org\",\nsku: \"SKU-DS-03\",\nquantity: 5,\nnotes: \"Stockout scenario (requested 5, only 1 on hand)\"\n}\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "06ccfdd7-f60e-4433-816b-df424fb7b7d1",
      "name": "Code_SimulateOrders"
    },
    {
      "parameters": {
        "url": "https://n8n.tayanasolutions.com/webhook/mock/sheets/inventory11",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "id": "0a173486-3bdf-4cbc-8a4e-83bfd66dbf6c",
      "name": "HTTP_GetInventoryRows"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const order = $node['Code_SimulateOrders'].json;\nconst inventoryRows = $input.item.json;\n// Find matching row by SKU\nconst matchedItem = (Array.isArray(inventoryRows) ? inventoryRows : [inventoryRows]).find(r => r.sku === order.sku);\nif (!matchedItem) {\nreturn {\njson: {\norderId: order.orderId,\nsku: order.sku,\nisAvailable: false,\nreason: \"SKU_NOT_FOUND_IN_INVENTORY\"\n}\n};\n}\nconst currentStock = Number(matchedItem.stockOnHand || 0);\nconst orderQty = Number(order.quantity || 0);\nconst reorderPoint = Number(matchedItem.reorderPoint || 0);\nconst unitPrice = Number(matchedItem.unitPrice || 0);\nconst isAvailable = currentStock >= orderQty;\nconst newStock = isAvailable ? currentStock - orderQty : currentStock;\nconst needsReorder = isAvailable && (newStock <= reorderPoint);\nconst totalPrice = Number((orderQty * unitPrice).toFixed(2));\nreturn {\njson: {\norderId: order.orderId,\ncustomerEmail: order.customerEmail,\nsku: order.sku,\nitemName: matchedItem.itemName,\nquantityOrdered: orderQty,\nunitPrice: unitPrice,\ntotalPrice: totalPrice,\npreviousStock: currentStock,\nnewStock: newStock,\nreorderPoint: reorderPoint,\nisAvailable: isAvailable,\nneedsReorder: needsReorder,\ntimestamp: new Date().toISOString()\n}\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "2fbf8262-e435-4570-87a2-4fa3f723f231",
      "name": "Code_ReconcileStock"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "3cf76a8b-0f4e-4280-ac8e-96fd906756a8",
              "leftValue": "={{ $json.isAvailable }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        896,
        0
      ],
      "id": "6bf532bb-6c15-4c7e-87a9-70c9f763aaea",
      "name": "IF_HasSufficientStock"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\njson: {\nevent: \"ORDER_REJECTED_STOCKOUT\",\norderId: $json.orderId,\nsku: $json.sku,\nrequestedQuantity: $json.quantityOrdered,\navailableStock: $json.previousStock,\nrejectedAt: new Date().toISOString()\n}\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
